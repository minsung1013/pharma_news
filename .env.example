# Gmail
GMAIL_ADDRESS=your@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
RECIPIENTS=your@gmail.com

# 큐레이션 튜닝 (기본값 그대로 사용 가능)
SCORE_THRESHOLD=3       # 이 점수 미만 기사는 제외
TOP_HIGHLIGHTS=6        # 하이라이트 개수
TOP_ORGS=8             # 통계 '주요 등장 기관' 개수
MAX_HL_CHARS=4000      # 하이라이트 본문 표시 상한(초과 제외)
MAX_NEWS_CHARS=1000    # 뉴스 요약 표시 상한(초과 제외)
FETCH_WINDOW_HOURS=24  # 수집 시간창

# 스크래핑(팟캐스트 원문 낭독용)
SCRAPE_TIMEOUT_SEC=30
